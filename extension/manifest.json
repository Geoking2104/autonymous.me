{
  "manifest_version": 3,
  "name": "Autonymous.me Wallet",
  "short_name": "Autonymous",
  "version": "0.5.1",
  "description": "Self-sovereign identity wallet — DID, credentials and Source Chain, on Holochain.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Autonymous.me Wallet",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8888/*", "http://localhost:9000/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
